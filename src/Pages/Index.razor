@page "/"
@using BlazorInvaders.GameObjects
@using BlazorInvaders.Rendering
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using System.Text.Json
@inject IJSRuntime JsRuntime;
@inject IConfiguration Config
@inject HttpClient Http
@inject IModalService Modal
@inject IWebAssemblyHostEnvironment HostEnvironment
@implements IAsyncDisposable

<div class="row page-title">
    <div class="col text-center">
        <h2>Blazor Invaders - a Space Invaders implementation</h2>
    </div>
</div>
<div class="row">
    <div class="col text-center">
        @if (_personalBest > 0)
        {
            <small style="color:#aaa">Your best: @_personalBest &nbsp;&nbsp;</small>
        }
        <a href="/leaderboard" style="color:#aaa; font-size:small">Leaderboard</a>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col text-center" id="canvas">
        @* Touch pads are only shown on touch screens (see app.css); game.js wires up their data-* inputs *@
        <div class="game-area" @ref="_gameArea">
            <div class="touch-pad touch-move">
                <button type="button" class="touch-btn" data-input="1" aria-label="Move left">&#9664;</button>
                <button type="button" class="touch-btn" data-input="2" aria-label="Move right">&#9654;</button>
            </div>
            <div tabindex="0" @ref="_container" class="game-canvas" id="canvasContainer">
                <canvas @ref="_canvas"></canvas>
            </div>
            <div class="touch-pad touch-actions">
                <button type="button" class="touch-btn touch-fire" data-input="4" aria-label="Fire">FIRE</button>
                <button type="button" class="touch-btn touch-small" data-press="16" aria-label="Pause">II</button>
            </div>
        </div>
    </div>
</div>

@code{
    const int Width = 870;
    const int Height = 500;

    // Tick input bits: the low bits are the held GameInput controls, these are one-shot presses (see game.js)
    const int HeldMask = 7;
    const int StartPressed = 8;
    const int PausePressed = 16;

    // Development only: /?wave=5 starts games on that wave, e.g. to try the boss
    [SupplyParameterFromQuery(Name = "wave")]
    public int? Wave { get; set; }
    int DevStartWave => HostEnvironment.IsDevelopment() && Wave is > 1 ? Wave.Value : 1;

    readonly GameEngine _engine = new(Width, Height);
    readonly SceneBuilder _scenes = new();
    ElementReference _gameArea;
    ElementReference _container;
    ElementReference _canvas;
    IJSObjectReference? _module;
    DotNetObjectReference<Index>? _dotNetRef;
    bool _disableKeyboard = false;
    bool _disposed = false;
    int _personalBest = 0;
    bool _prevGameOver = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/game.js");
        if (_disposed) return;

        var stored = await _module.InvokeAsync<string?>("getItem", "personalBest");
        if (int.TryParse(stored, out var pb))
            _personalBest = pb;

        _engine.QualifiedForLeaderboard += OnQualifiedForLeaderboard;
        _dotNetRef = DotNetObjectReference.Create(this);
        // Returns whether this is a touch screen, so on-screen hints can say "tap" instead of "press space"
        _scenes.TouchControls = await _module.InvokeAsync<bool>("start", _dotNetRef, _canvas, _container, _gameArea, Width, Height);
        await _container.FocusAsync();
        StateHasChanged();

        // Fetched after the loop starts so a cold API doesn't hold up the game
        await LoadLeaderboardAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module != null)
        {
            // Stop the JS frame loop before releasing the .NET reference it calls into
            await _module.InvokeVoidAsync("stop");
            await _module.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }

    /// <summary>Called by game.js once per animation frame with the controls held and pressed since the last frame.</summary>
    [JSInvokable]
    public async ValueTask<Scene> Tick(float timeStamp, int input)
    {
        if (_disableKeyboard)
            input = 0;

        var wasStarted = _engine.Started;
        HandlePresses(input, timeStamp);
        // The press that starts a game shouldn't also fire its first shot
        var held = (GameInput)(input & HeldMask);
        if (!wasStarted && _engine.Started)
            held &= ~GameInput.Fire;
        _engine.SetInput(held);

        _engine.Update(timeStamp);
        var scene = _scenes.Build(_engine, timeStamp);

        if (_engine.GameOver && !_prevGameOver)
        {
            _prevGameOver = true;
            if (_engine.Points > _personalBest)
            {
                _personalBest = _engine.Points;
                await _module!.InvokeVoidAsync("setItem", "personalBest", _personalBest.ToString());
            }
            StateHasChanged();
        }
        else if (!_engine.GameOver)
        {
            _prevGameOver = false;
        }

        return scene;
    }

    void HandlePresses(int input, float timeStamp)
    {
        if ((input & PausePressed) != 0 && _engine.Started)
            _engine.TogglePause();

        if ((input & StartPressed) != 0 && !_engine.Started)
            _engine.Start(timeStamp, DevStartWave);
    }

    private async Task LoadLeaderboardAsync()
    {
        try
        {
            // Scores saved while offline go first, so they show up in the board we fetch
            await SendPendingScoresAsync();
            var scores = await Http.GetFromJsonAsync<List<HighScore>>($"{Config["FunctionsApi"]}/getleaderboard");
            if (scores != null)
                _engine.SetLeaderboard(scores);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Leaderboard unavailable: {ex.Message}");
        }
    }

    // Raised from inside Tick; the dialog runs on its own and reports its own failures
    void OnQualifiedForLeaderboard() => _ = SubmitHighScoreAsync();

    private async Task SubmitHighScoreAsync()
    {
        _disableKeyboard = true;
        try
        {
            var title = _engine.Points >= _engine.HighScore ? "New High Score!" : "You made the leaderboard!";
            var result = await Modal.Show<SetHighScore>(title).Result;
            if (result.Cancelled || result.Data is not HighScore score)
                return;

            score.Score = _engine.Points;
            if (_engine.Points >= _engine.HighScore)
                _engine.HighScoreName = score.Name;
            if (!await SendScoreAsync(score))
                await QueueScoreAsync(score);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Saving high score failed: {ex.Message}");
        }
        finally
        {
            _disableKeyboard = false;
            // The dialog took focus; give it back so the keys work without clicking the game
            if (!_disposed)
                await _container.FocusAsync();
        }
    }

    /// <summary>Posts a score. Returns false if the API couldn't be reached, so it can be retried later.</summary>
    private async Task<bool> SendScoreAsync(HighScore score)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"{Config["FunctionsApi"]}/savehighscore", score);
            // A rejected score would be rejected again, so only network failures are retried
            if (!response.IsSuccessStatusCode)
                Console.Error.WriteLine($"Saving high score failed: {(int)response.StatusCode} {await response.Content.ReadAsStringAsync()}");
            return true;
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"High score not sent, will retry later: {ex.Message}");
            return false;
        }
    }

    // Scores earned offline wait in localStorage until the API is reachable again
    const string PendingScoresKey = "pendingScores";
    const int MaxPendingScores = 10;

    private async Task QueueScoreAsync(HighScore score)
    {
        var pending = await ReadPendingScoresAsync();
        pending.Add(score);
        await WritePendingScoresAsync(pending.TakeLast(MaxPendingScores).ToList());
    }

    private async Task SendPendingScoresAsync()
    {
        var pending = await ReadPendingScoresAsync();
        if (pending.Count == 0) return;

        var sent = 0;
        while (sent < pending.Count && await SendScoreAsync(pending[sent]))
            sent++;
        await WritePendingScoresAsync(pending.Skip(sent).ToList());
    }

    private async Task<List<HighScore>> ReadPendingScoresAsync()
    {
        var json = await _module!.InvokeAsync<string?>("getItem", PendingScoresKey);
        try
        {
            return string.IsNullOrEmpty(json) ? new() : JsonSerializer.Deserialize<List<HighScore>>(json) ?? new();
        }
        catch (JsonException)
        {
            return new();
        }
    }

    private async Task WritePendingScoresAsync(List<HighScore> pending) =>
        await _module!.InvokeVoidAsync("setItem", PendingScoresKey, JsonSerializer.Serialize(pending));
}
