@page "/leaderboard"
@using BlazorInvaders.GameObjects
@using BlazorInvaders.Rendering
@implements IDisposable
@inject HttpClient Http
@inject IConfiguration Config

<div class="row">
    <div class="col text-center">
        <h2>Leaderboard</h2>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-auto">
        <div class="btn-group mb-3" role="tablist">
            <button type="button" role="tab" aria-selected="@(!_daily)" @ref="_allTimeTab"
                    class="btn @(_daily ? "btn-outline-light" : "btn-light")" @onclick="() => ShowAsync(daily: false)">All-time</button>
            <button type="button" role="tab" aria-selected="@_daily" @ref="_dailyTab"
                    class="btn @(_daily ? "btn-light" : "btn-outline-light")" @onclick="() => ShowAsync(daily: true)">Today's challenge</button>
        </div>

        @if (_daily)
        {
            <p class="text-center" style="color:#aaa">
                @_today.Date.ToString("yyyy-MM-dd") &middot; @SceneBuilder.Describe(_today.Modifier)
            </p>
        }

        @if (_loadFailed)
        {
            <p role="alert">Could not load the leaderboard. Check your connection and try again.</p>
            <button type="button" class="btn btn-secondary mt-2" @onclick="RetryAsync">Try again</button>
        }
        else if (_scores == null)
        {
            <p>Loading...</p>
        }
        else if (_scores.Count == 0)
        {
            <p>No scores yet. Be the first!</p>
        }
        else
        {
            <table class="table table-dark table-striped" style="min-width:300px">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _scores.Count; i++)
                    {
                        var rank = i + 1;
                        var entry = _scores[i];
                        <tr>
                            <td>@rank</td>
                            <td>@entry.Name</td>
                            <td>@entry.Score</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <a href="/" class="btn btn-secondary mt-2">Back to game</a>
    </div>
</div>

@code {
    private readonly DailyChallenge _today = DailyChallenge.Today();
    private List<HighScore>? _scores;
    private bool _daily;
    private bool _loadFailed;
    private ElementReference _allTimeTab;
    private ElementReference _dailyTab;
    private int _request;
    private bool _disposed;

    protected override Task OnInitializedAsync() => ShowAsync(daily: false);

    private async Task RetryAsync()
    {
        await ShowAsync(daily: _daily);
        // The Try again button leaves the page while the board loads, so focus moves to the selected tab.
        // The user may have left the page during the load, and the element is gone then.
        if (!_disposed)
            await (_daily ? _dailyTab : _allTimeTab).FocusAsync();
    }

    public void Dispose() => _disposed = true;

    private async Task ShowAsync(bool daily)
    {
        _daily = daily;
        _scores = null;
        _loadFailed = false;
        var request = ++_request;
        var url = daily
            ? $"{Config["FunctionsApi"]}/getleaderboard?mode=daily&day={_today.Key}"
            : $"{Config["FunctionsApi"]}/getleaderboard";
        try
        {
            var scores = await Http.GetFromJsonAsync<List<HighScore>>(url) ?? new();
            // Ignore a slow response once a newer load (another tab, or a retry) has started
            if (request == _request)
                _scores = scores;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Leaderboard unavailable: {ex.Message}");
            if (request == _request)
                _loadFailed = true;
        }
    }
}
