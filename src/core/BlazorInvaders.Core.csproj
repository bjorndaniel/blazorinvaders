<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game rules and scene description. No Blazor or browser dependencies, so it is unit-testable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorInvaders</RootNamespace>
    <!-- CG60: every public member of core has an XML summary; a missing one fails the build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets tests set up engine state (combo, waves, power-ups) directly -->
    <InternalsVisibleTo Include="BlazorInvaders.Tests" />
  </ItemGroup>

</Project>
