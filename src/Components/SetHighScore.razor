@using BlazorInvaders.GameObjects

<div class="simple-form text-center">
    <div class="row">
        <div class="col">
            <label id="initials-label">Enter your initials</label>
        </div>
    </div>
    <div class="row" role="group" aria-labelledby="initials-label">
        <div class="col">
            <input class="initials" type="text" maxlength="1" aria-label="Initial 1 of 3" @bind="First" />
        </div>
        <div class="col">
            <input class="initials" type="text" maxlength="1" aria-label="Initial 2 of 3" @bind="Second" />
        </div>
        <div class="col">
            <input class="initials" type="text" maxlength="1" aria-label="Initial 3 of 3" @bind="Third" />
        </div>
    </div>
    @if (_error != null)
    {
        <div class="row">
            <div class="col text-danger">@_error</div>
        </div>
    }
    <br />
    <div class="row">
        <div class="col">
            <button @onclick="SaveHighScore" class="btn btn-primary">Submit</button>
            <button @onclick="async () => await BlazoredModal.CancelAsync()" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    private HighScore _highScore = default!;
    private char First { get; set; }
    private char Second { get; set; }
    private char Third { get; set; }
    private string? _error;

    async Task SaveHighScore()
    {
        // Keep only A-Z / 0-9 (what the API accepts); blank inputs bind as '\0'
        var name = new string(new[] { First, Second, Third }
            .Select(char.ToUpperInvariant)
            .Where(c => c is >= 'A' and <= 'Z' or >= '0' and <= '9')
            .ToArray());
        if (name.Length == 0)
        {
            _error = "Use letters A-Z or digits";
            return;
        }

        _highScore = new HighScore
        {
            Name = name
        };
        await BlazoredModal.CloseAsync(ModalResult.Ok(_highScore));
    }
}
